module Byomailer
  VERSION: String

  type id = Integer | String
  type attributes = Hash[Symbol | String, untyped]
  type filters = Array[Hash[Symbol | String, untyped]]

  def self.configure: () { (Configuration) -> void } -> void
  def self.config: () -> Configuration
  def self.client: () -> Client
  def self.reset!: () -> void
  def self.contacts: () -> Contacts
  def self.lists: () -> Lists
  def self.topics: () -> Topics
  def self.tags: () -> Tags
  def self.newsletters: () -> Newsletters
  def self.sequences: () -> Sequences
  def self.blocks: () -> Blocks
  def self.email_templates: () -> EmailTemplates
  def self.email_identities: () -> EmailIdentities
  def self.email_logs: () -> EmailLogs
  def self.projects: () -> Projects
  def self.webhook_endpoints: () -> WebhookEndpoints

  class Configuration
    attr_writer url: String?
    attr_writer token: String?
    attr_writer webhook_secret: String?
    attr_accessor timeout: Numeric
    attr_accessor max_retries: Integer

    def initialize: () -> void
    def url: () -> String?
    def token: () -> String?
    def webhook_secret: () -> String?
    def merge!: (Hash[Symbol | String, untyped]? settings) -> self
    def to_h: () -> { url: String?, token: String?, timeout: Numeric, max_retries: Integer }
  end

  class Client
    class Response
      attr_reader status: Integer
      attr_reader body: untyped

      def self.new: (status: Integer, body: untyped) -> Response
    end

    BEFORE_SEND: Array[singleton(Exception)]
    AFTER_SEND: Array[singleton(Exception)]
    BASE_DELAY: Float
    MAX_DELAY: Integer
    MAX_RETRY_AFTER: Integer

    attr_reader url: String
    attr_reader timeout: Numeric
    attr_reader max_retries: Integer

    def initialize: (?url: String?, ?token: String?, ?timeout: Numeric, ?max_retries: Integer) -> void
    def contacts: () -> Contacts
    def lists: () -> Lists
    def topics: () -> Topics
    def tags: () -> Tags
    def newsletters: () -> Newsletters
    def sequences: () -> Sequences
    def blocks: () -> Blocks
    def email_templates: () -> EmailTemplates
    def email_identities: () -> EmailIdentities
    def email_logs: () -> EmailLogs
    def projects: () -> Projects
    def webhook_endpoints: () -> WebhookEndpoints
    def request: (Symbol method, String path, ?query: Hash[Symbol | String, untyped]?, ?json: untyped, ?idempotent: bool) -> Response
  end

  class Record
    def self.wrap: (untyped value) -> untyped
    def initialize: (Hash[Symbol | String, untyped] attributes) -> void
    def []: (Symbol | String key) -> untyped
    def key?: (Symbol | String key) -> bool
    def to_h: () -> Hash[String, untyped]
    def ==: (untyped other) -> bool
  end

  class Page
    include Enumerable[Record]

    attr_reader records: Array[Record]
    attr_reader meta: Record

    def initialize: (Array[untyped]? records, Hash[String, untyped]? meta) { (String cursor) -> Page } -> void
    def each: () { (Record) -> void } -> Array[Record]
    def next_cursor: () -> String?
    def next_page?: () -> bool
    def next_page: () -> Page?
    def each_record: () { (Record) -> void } -> void
                   | () -> Enumerator[Record, void]
  end

  class Error < StandardError
  end

  class ConfigurationError < Error
  end

  class ConnectionError < Error
  end

  class ApiError < Error
    attr_reader status: Integer
    attr_reader body: untyped

    def self.for: (Net::HTTPResponse response) -> ApiError
    def self.class_for: (Integer status) -> singleton(ApiError)
    def initialize: (Net::HTTPResponse response, untyped body) -> void
  end

  class AuthenticationError < ApiError
  end

  class AuthorizationError < ApiError
  end

  class NotFoundError < ApiError
  end

  class ServerError < ApiError
  end

  class ValidationError < ApiError
    def errors: () -> Hash[String, Array[String]]
  end

  class RateLimitError < ApiError
    def retry_after: () -> Integer?
  end

  class WebhookVerificationError < Error
    attr_reader reason: :signature | :timestamp

    def initialize: (:signature | :timestamp reason, String message) -> void
  end

  module Webhook
    EVENT: String
    DELIVERY: String
    TIMESTAMP: String
    SIGNATURE: String
    TOLERANCE: Integer
    EVENTS: Array[String]

    def self.verify: (String body, untyped headers, ?secret: String?, ?tolerance: Integer, ?now: Time | Integer) -> Record
    def self.sign: (String | Integer timestamp, String body, String secret) -> String
  end

  class Resource
    def initialize: (Client client) -> void
  end

  class Contacts < Resource
    class Added < Record
      def initialize: (Hash[String, untyped] attributes, created: bool) -> void
      def created?: () -> bool
    end

    def list: (?lists: Array[id]?, ?tags: Array[id]?, ?topics: Array[id]?, ?search: String?, ?include_unsubscribed: bool?, ?per_page: Integer?, ?cursor: String?) -> Page
    def find: (id id) -> Record
    def add: (String email, list: id, ?name: String?, ?tags: Array[String]?, ?attributes: attributes) -> Added
    def update: (id id, ?email: String?, ?name: String?, ?tags: Array[String]?, ?remove_tags: Array[String]?, ?attributes: attributes) -> Record
    def unsubscribe: (id id) -> Record
    def remove: (id id, list: id) -> Record
  end

  class Lists < Resource
    def list: (?per_page: Integer?, ?cursor: String?) -> Page
    def create: (name: String) -> Record
    def rename: (id id, name: String) -> Record
    def delete: (id id) -> nil
  end

  class Topics < Resource
    def list: (list: id) -> Array[Record]
    def create: (list: id, name: String, ?description: String?) -> Record
    def update: (id id, list: id, name: String, ?description: String?) -> Record
    def delete: (id id, list: id) -> nil
  end

  class Tags < Resource
    def list: () -> Array[Record]
    def create: (name: String) -> Record
    def rename: (id id, name: String) -> Record
    def delete: (id id) -> nil
  end

  class Newsletters < Resource
    def list: (?status: String?, ?search: String?, ?project: id?, ?per_page: Integer?, ?cursor: String?) -> Page
    def find: (id id) -> Record
    def create: (**untyped attributes) -> Record
    def update: (id id, **untyped attributes) -> Record
    def delete: (id id) -> nil
    def count_recipients: (?filters: filters) -> Integer
    def send_test_email: (id id) -> Record
    def pick_winner: (id id, String | Symbol variant) -> Record
    def variables: (id id) -> Record
    def replace_variables: (id id, Hash[Symbol | String, String?]? variables) -> Record
  end

  class Sequences < Resource
    def list: (?status: String?, ?search: String?, ?project: id?, ?per_page: Integer?, ?cursor: String?) -> Page
    def find: (id id) -> Record
    def stats: (id id) -> Record
    def step: (id id, id step_id) -> Record
    def step_stats: (id id, id step_id) -> Record
    def replace_step_filters: (id id, id step_id, filters filters) -> Record
    def variables: (id id) -> Record
    def replace_variables: (id id, Hash[Symbol | String, String?]? variables) -> Record
    def export_step_mails: (id id, id step_id, **untyped filters) -> String
  end

  class Blocks < Resource
    def list: () -> Array[Record]
    def find: (id id) -> Record
    def create: (name: String, html_content: String) -> Record
    def update: (id id, name: String, html_content: String) -> Record
    def delete: (id id) -> nil
  end

  class EmailTemplates < Resource
    def list: (?archived: bool?, ?is_default: bool?, ?per_page: Integer?, ?cursor: String?) -> Page
    def find: (id id) -> Record
    def default: () -> Record
  end

  class EmailIdentities < Resource
    def list: (?identity_status: String?, ?per_page: Integer?, ?cursor: String?) -> Page
    def find: (id id) -> Record
  end

  class EmailLogs < Resource
    def list: (?status: String?, ?operation: String?, ?recipient: String?, ?per_page: Integer?, ?cursor: String?) -> Page
    def find: (id id) -> Record
  end

  class Projects < Resource
    def list: (?per_page: Integer?, ?cursor: String?) -> Page
    def find: (id id) -> Record
    def create: (name: String) -> Record
    def rename: (id id, name: String) -> Record
    def delete: (id id) -> nil
  end

  class WebhookEndpoints < Resource
    def list: (?per_page: Integer?, ?cursor: String?) -> Page
    def find: (id id) -> Record
    def create: (url: String, events: Array[String], ?description: String?) -> Record
    def update: (id id, **untyped attributes) -> Record
    def delete: (id id) -> nil
    def deliveries: (id id, ?per_page: Integer?, ?cursor: String?) -> Page
    def rotate_secret: (id id) -> Record
    def send_test: (id id) -> Record
  end
end
